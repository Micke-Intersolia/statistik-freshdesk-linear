        }]
      }
    },

    "*": {
      "*": {
        "background": [{
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "border": [{
          "color": { "solid": { "color": "#EAECF0" } },
          "show": true
        }],
        "title": [{
          "fontColor": { "solid": { "color": "#101828" } },
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontBold": true
        }]
      }
    },

    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#101828" } },
          "fontFamily": "Inter",
          "fontSize": 28,
          "bold": true
        }],
        "categoryLabels": [{
          "color": { "solid": { "color": "#475467" } },
          "fontFamily": "Inter",
          "fontSize": 10,
          "show": true
