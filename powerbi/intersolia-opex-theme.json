{
  "name": "Intersolia OPEX",

  "dataColors": [
    "#2C786C",
    "#54B09E",
    "#F79009",
    "#F04438",
    "#27625A",
    "#98A2B3",
    "#344054",
    "#80CCBB"
  ],

  "good":    "#2C786C",
